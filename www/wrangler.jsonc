{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-mind-social",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "cloudmindsocial.com", "custom_domain": true },
    { "pattern": "www.cloudmindsocial.com", "custom_domain": true }
  ],
  // Inquiry storage + admin accounts. Create with:
  //   npx wrangler d1 create cloud-mind-social
  // then paste the returned id over the placeholder below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-mind-social",
      "database_id": "24a36626-8cc2-44a9-85e4-2970a654d1fa",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Email Sending (beta, Workers Paid). The sending domain must be
  // onboarded under Compute > Email Service > Email Sending first; that adds
  // records on a cf-bounce. subdomain and leaves existing mail untouched.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SITE_URL": "https://cloudmindsocial.com",
    "MAIL_FROM": "Cloud Mind Social <hello@cloudmindsocial.com>",
    "MAIL_REPLY_TO": "hello@cloudmindsocial.com",
    "INQUIRY_NOTIFY_TO": "hello@cloudmindsocial.com"
  },
  // Named environments repeat most top-level config because they do not
  // inherit it — with the exception of `routes`, which they DO inherit.
  // Staging therefore declares an empty `routes` explicitly: without it a
  // staging deploy reassigns the production custom domains onto the staging
  // Worker. `workers_dev` gives staging its own URL to be previewed at:
  //   https://cloud-mind-social-staging.<account-subdomain>.workers.dev
  "env": {
    "staging": {
      "name": "cloud-mind-social-staging",
      "main": ".open-next/worker.js",
      "routes": [],
      "workers_dev": true,
      "compatibility_date": "2026-08-29",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloud-mind-social-staging",
          "database_id": "d97ac4b3-d3fd-4c24-8c9e-59e4bee81255",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "SITE_URL": "https://cloud-mind-social-staging.workers.dev",
        "MAIL_FROM": "Cloud Mind Social <hello@cloudmindsocial.com>",
        "MAIL_REPLY_TO": "hello@cloudmindsocial.com",
        "INQUIRY_NOTIFY_TO": "hello@cloudmindsocial.com"
      }
    }
  }
}
